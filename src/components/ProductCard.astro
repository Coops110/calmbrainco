---
const { product } = Astro.props;
const { data } = product;
const slug = product.slug ?? product.id;
---
<a class="product-card" href={`/shop/${slug}`}>
  <img src={data.heroImage} alt={data.title} loading="lazy" />
  <div class="card-body">
    <span class="category-pill">{data.category}</span>
    <h3>{data.title}</h3>
    <p>{data.tagline}</p>
    <span class="price-tag">${data.price.toFixed(2)}</span>
  </div>
</a>
