---
import '@fontsource-variable/instrument-sans';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import { SITE, organizationNode, websiteNode, graph } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/shop/adhd-planner-bundle/" — always with leading+trailing slash, "/" for home
  ogImage?: string; // absolute or root-relative path to a 1200x630 PNG
  type?: 'website' | 'article' | 'product';
  publishDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
  jsonLd?: unknown[]; // extra graph nodes for this page
  price?: number; // product pages: emits Pinterest product OG tags
}

const {
  title,
  description,
  path,
  ogImage = '/og/default.png',
  type = 'website',
  publishDate,
  modifiedDate,
  noindex = false,
  jsonLd = [],
  price,
} = Astro.props;

const canonicalURL = `${SITE}${path}`;
const fullTitle = title.includes('Calm Brain Co') ? title : `${title} | Calm Brain Co`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;

const PINTEREST_TAG_ID = '2614020631577';
const GA4_MEASUREMENT_ID = 'G-9YLBB6D9QL';

const pageGraph = graph([organizationNode, websiteNode, ...jsonLd]);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonicalURL} />}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content="Calm Brain Co" />
  <meta name="p:domain_verify" content="4f97711671a749142ea59ed1ed7c95b0" />
  <meta name="google-site-verification" content="5hxrdZ_9bZnheUJVB-hjzll9ZYQgSY7FjEstzy8UXhM" />
  <meta name="theme-color" content="#FAF6EE" />
  <meta name="color-scheme" content="light" />

  <meta property="og:type" content={type === 'product' ? 'product' : type} />
  <meta property="og:site_name" content="Calm Brain Co" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  {publishDate && <meta property="article:published_time" content={publishDate} />}
  {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
  {typeof price === 'number' && <meta property="product:price:amount" content={String(price)} />}
  {typeof price === 'number' && <meta property="product:price:currency" content="USD" />}
  {typeof price === 'number' && <meta property="og:availability" content="instock" />}
  {typeof price === 'number' && <meta property="og:brand" content="Calm Brain Co" />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <meta name="twitter:image:alt" content={title} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="Calm Brain Co blog" href="/rss.xml" />
  <link rel="describedby" href="/llms.txt" />

  <script type="text/javascript" async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
  <script type="text/javascript" define:vars={{ GA4_MEASUREMENT_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', GA4_MEASUREMENT_ID);
  </script>
  <script type="text/javascript" define:vars={{ PINTEREST_TAG_ID }}>
    !function(e){if(!window.pintrk){window.pintrk = function () {
    window.pintrk.queue.push(Array.prototype.slice.call(arguments))};var
      n=window.pintrk;n.queue=[],n.version="3.0";var
      t=document.createElement("script");t.async=!0,t.src=e;var
      r=document.getElementsByTagName("script")[0];
      r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
    pintrk('load', PINTEREST_TAG_ID);
    pintrk('page');
  </script>

  <script type="application/ld+json" set:html={pageGraph} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
</body>
</html>
