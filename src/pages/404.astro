---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Page not found"
  description="This page does not exist."
  path="/404/"
  noindex={true}
>
  <Header />
  <main id="main">
    <section class="notfound">
      <div class="wrap">
        <span class="chunk__label">404</span>
        <h1>That page is not here.</h1>
        <p class="measure">The link might be old, or the address might have a typo. Try the planners, the blog, or home.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/">Go home</a>
          <a class="text-link" href="/shop/">See the planners</a>
          <a class="text-link" href="/blog/">Read the blog</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
