---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BigThree from '../components/BigThree.astro';
import Reasons from '../components/Reasons.astro';
import FaqList from '../components/FaqList.astro';
import { budgetPlanner, homeResetPlanner, studentPlanner, workFocusPlanner, familyHouseholdPlanner, holidayGiftBudgetTracker, newYearNoResolutions, findPage } from '../data/products';
import { SITE } from '../lib/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

const workdayTop3 = findPage(workFocusPlanner, 'workday-top-3')!;
const billTracker = findPage(budgetPlanner, 'bill-tracker')!;
const mentalLoad = findPage(familyHouseholdPlanner, 'mental-load-dump')!;
const tenMinute = findPage(homeResetPlanner, 'ten-minute-reset')!;
const holidayCover = findPage(holidayGiftBudgetTracker, 'gift-list-budget')!;
const newYearCover = findPage(newYearNoResolutions, 'instead-of-a-resolution')!;

const faq = [
  { q: 'Do I print it or use it on a tablet?', a: 'Either, it is your choice. Each planner is one PDF: print it at home or at a copy shop, or open it in a tablet app like GoodNotes or Notability and write on it with a stylus. Nothing is shipped.' },
  { q: 'US Letter or A4?', a: 'Both sizes are in the one purchase, so there is nothing to choose.' },
  { q: 'Is it dated?', a: 'No. Every page is undated on purpose, so you can start on any day and a late start wastes nothing.' },
  { q: 'How much is each planner?', a: 'Every planner is $3.99. One price, no tiers, no upsell. You get the full PDF the moment you pay.' },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${SITE}/#webpage`,
    url: `${SITE}/`,
    name: 'Calm Brain Co: Printable ADHD Planners for Real Days',
    description: 'Printable planners for ADHD brains, every one $3.99: three time blocks instead of hourly slots, a cap of three priorities, and no streaks to break.',
    isPartOf: { '@id': `${SITE}/#website` },
    inLanguage: 'en',
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE}/#products`,
    name: 'Printable planners by Calm Brain Co',
    numberOfItems: 7,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ADHD-Friendly Budget Planner', url: `${SITE}/shop/budget-planner/` },
      { '@type': 'ListItem', position: 2, name: 'ADHD Home Reset Planner', url: `${SITE}/shop/adhd-home-reset-planner/` },
      { '@type': 'ListItem', position: 3, name: 'ADHD Student Planner', url: `${SITE}/shop/adhd-student-planner/` },
      { '@type': 'ListItem', position: 4, name: 'ADHD Work and Focus Planner', url: `${SITE}/shop/adhd-work-focus-planner/` },
      { '@type': 'ListItem', position: 5, name: 'ADHD Family and Household Planner', url: `${SITE}/shop/adhd-family-household-planner/` },
      { '@type': 'ListItem', position: 6, name: 'Holiday Gift & Budget Tracker', url: `${SITE}/holiday-gift-budget-tracker/` },
      { '@type': 'ListItem', position: 7, name: 'New Year, No Resolutions', url: `${SITE}/new-year-no-resolutions/` },
    ],
  },
];
---
<BaseLayout
  title="Calm Brain Co: Printable ADHD Planners for Real Days"
  description="Printable planners for ADHD brains, every one $3.99: three time blocks instead of hourly slots, a cap of three priorities, and no streaks to break."
  path="/"
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <div class="hero__copy">
          <p class="weekof" aria-label="Week of: any week you like"><span>Week of</span><span class="line" aria-hidden="true"><span>any week you like</span></span></p>
          <h1 id="hero-title">Plan the day you actually have.</h1>
          <p class="hero__lead">ADHD planners to print or use on a tablet. <b>Morning, afternoon and evening</b> instead of hourly slots. <b>Three priorities</b>, not a list of twenty. No streaks to break. Undated, so you can start today. <b>Every planner is $3.99.</b></p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/shop/">See the planners <span class="price">$3.99 each</span></a>
          </div>
        </div>
        <BigThree />
      </div>
    </section>

    <section class="chunk chunk--morning" aria-labelledby="morning-title">
      <div class="wrap">
        <div class="chunk__head">
          <span class="chunk__label">Morning</span>
          <h2 id="morning-title">Pick a planner</h2>
          <p>Seven planners, built the same way, <b>$3.99 each</b>. Each is one PDF you download the moment you buy: print it at home, or write on it in a tablet app like GoodNotes. US Letter and A4 in the same download.</p>
        </div>
        <div class="products">
          <article class="product">
            <div class="paper paper--cover"><Image src={budgetPlanner.pages[0].img} alt={budgetPlanner.pages[0].alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/shop/budget-planner/" style="color:inherit;text-decoration:none">ADHD-Friendly Budget Planner</a></h3>
              <p>Money on paper for brains that forget subscriptions exist and close the spreadsheet. Three honest buckets, a bill tracker, and a savings page with no deadline.</p>
              <p class="product__facts">9 pages. Undated. Instant PDF.</p>
              <p class="product__price">${budgetPlanner.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/shop/budget-planner/">See all 9 pages</a>
            </div>
          </article>
          <article class="product">
            <div class="paper paper--cover"><Image src={homeResetPlanner.pages[0].img} alt={homeResetPlanner.pages[0].alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/shop/adhd-home-reset-planner/" style="color:inherit;text-decoration:none">ADHD Home Reset Planner</a></h3>
              <p>A cleaning system for brains that lose the thread halfway through a room. A zone map you build yourself, a 10-minute reset, and a laundry tracker that never loses a load.</p>
              <p class="product__facts">11 pages. Undated. Instant PDF.</p>
              <p class="product__price">${homeResetPlanner.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/shop/adhd-home-reset-planner/">See all 11 pages</a>
            </div>
          </article>
          <article class="product">
            <div class="paper paper--cover"><Image src={studentPlanner.pages[0].img} alt={studentPlanner.pages[0].alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/shop/adhd-student-planner/" style="color:inherit;text-decoration:none">ADHD Student Planner</a></h3>
              <p>A school planner for brains that do their best work the night before, on purpose. A class schedule, an assignment tracker that counts down in days instead of a date, and a big project breakdown that gets you to one next tiny step.</p>
              <p class="product__facts">10 pages. Undated. Instant PDF.</p>
              <p class="product__price">${studentPlanner.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/shop/adhd-student-planner/">See all 10 pages</a>
            </div>
          </article>
          <article class="product">
            <div class="paper paper--cover"><Image src={workFocusPlanner.pages[0].img} alt={workFocusPlanner.pages[0].alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/shop/adhd-work-focus-planner/" style="color:inherit;text-decoration:none">ADHD Work and Focus Planner</a></h3>
              <p>A workday system for getting unstuck, one tiny step at a time. A task breakdown page that gets you to one next tiny step, a focus session tracker with a body-doubling slot, and no hourly grid anywhere.</p>
              <p class="product__facts">10 pages. Undated. Instant PDF.</p>
              <p class="product__price">${workFocusPlanner.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/shop/adhd-work-focus-planner/">See all 10 pages</a>
            </div>
          </article>
          <article class="product">
            <div class="paper paper--cover"><Image src={familyHouseholdPlanner.pages[0].img} alt={familyHouseholdPlanner.pages[0].alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/shop/adhd-family-household-planner/" style="color:inherit;text-decoration:none">ADHD Family and Household Planner</a></h3>
              <p>A household system for the ADHD parent who is done being the only one who remembers everything. A family week-at-a-glance command page, a mental load dump, and a chore rotation that reassigns who does what every week.</p>
              <p class="product__facts">10 pages. Undated. Instant PDF.</p>
              <p class="product__price">${familyHouseholdPlanner.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/shop/adhd-family-household-planner/">See all 10 pages</a>
            </div>
          </article>
          <article class="product">
            <div class="paper paper--cover"><Image src={holidayCover.img} alt={holidayCover.alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/holiday-gift-budget-tracker/" style="color:inherit;text-decoration:none">Holiday Gift & Budget Tracker</a></h3>
              <p>Short bursts, not one overwhelming shopping trip. A written budget per person, and a five-category spending overview for the whole season.</p>
              <p class="product__facts">2 pages. Undated. Instant digital PDF.</p>
              <p class="product__price">${holidayGiftBudgetTracker.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/holiday-gift-budget-tracker/">See both pages</a>
            </div>
          </article>
          <article class="product">
            <div class="paper paper--cover"><Image src={newYearCover.img} alt={newYearCover.alt} loading="lazy" width={420} /></div>
            <div class="product__body">
              <h3><a href="/new-year-no-resolutions/" style="color:inherit;text-decoration:none">New Year, No Resolutions</a></h3>
              <p>A re-entry point, not a resolution. Write your restart rules in advance, then a 12-month check-in with no streak math anywhere on it.</p>
              <p class="product__facts">2 pages. Undated. Instant digital PDF.</p>
              <p class="product__price">${newYearNoResolutions.price.toFixed(2)}</p>
              <a class="btn btn--secondary" href="/new-year-no-resolutions/">See both pages</a>
            </div>
          </article>
        </div>
        <p class="chunk__foot">Checkout happens on Gumroad or Payhip. No account on this site, no shipping, no waiting: the PDF is yours within a minute of paying.</p>
      </div>
    </section>

    <section class="chunk chunk--afternoon" aria-labelledby="afternoon-title">
      <div class="wrap">
        <div class="chunk__head">
          <span class="chunk__label">Afternoon</span>
          <h2 id="afternoon-title">Built to survive a bad Tuesday</h2>
          <p>Most planners assume a brain that runs on schedule. These pages assume a real week: a slow start, a task that runs long, a day that gets skipped. Nothing about them falls apart when that happens.</p>
        </div>
        <Reasons />

        <div class="inside">
          <div class="inside__head">
            <h3>A look at the real pages</h3>
            <span class="soft small">One page from four of the planners</span>
          </div>
          <div class="strip" role="list">
            <figure class="sheet" role="listitem">
              <div class="paper"><Image src={workdayTop3.img} alt={workdayTop3.alt} loading="lazy" width={320} /></div>
              <figcaption><b>Workday Top 3</b> <span class="soft">Three real priorities. Not a task list of twenty.</span></figcaption>
            </figure>
            <figure class="sheet" role="listitem">
              <div class="paper"><Image src={billTracker.img} alt={billTracker.alt} loading="lazy" width={320} /></div>
              <figcaption><b>Bill Tracker</b> <span class="soft">Amount, due date, a paid circle. Every bill in one place.</span></figcaption>
            </figure>
            <figure class="sheet" role="listitem">
              <div class="paper"><Image src={mentalLoad.img} alt={mentalLoad.alt} loading="lazy" width={320} /></div>
              <figcaption><b>Mental Load Dump</b> <span class="soft">Everything being carried that nobody else can see.</span></figcaption>
            </figure>
            <figure class="sheet" role="listitem">
              <div class="paper"><Image src={tenMinute.img} alt={tenMinute.alt} loading="lazy" width={320} /></div>
              <figcaption><b>The 10-Minute Reset</b> <span class="soft">Pick three small things, not ten.</span></figcaption>
            </figure>
          </div>
          <a class="btn btn--primary" href="/shop/">See every planner <span class="price">$3.99 each</span></a>
        </div>
      </div>
    </section>

    <section class="chunk chunk--evening" aria-labelledby="evening-title">
      <div class="wrap">
        <div class="chunk__head">
          <span class="chunk__label">Evening</span>
          <h2 id="evening-title">Reading, and questions</h2>
        </div>
        <div class="reading">
          <h3>Reading, if you want the thinking behind the pages</h3>
          <ul>
            {posts.map((post) => (
              <li><a href={`/blog/${post.id}/`}><span class="o" aria-hidden="true"></span>{post.data.title}</a></li>
            ))}
          </ul>
          <p class="more"><a href="/blog/">All the posts</a></p>
        </div>

        <div class="questions">
          <h3>Questions</h3>
          <FaqList faq={faq} />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
