---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { adhdPlannerBundle, findPage } from '../data/products';
import { SITE, breadcrumbNode } from '../lib/seo';

const gumroadUrl = adhdPlannerBundle.gumroad;
const payhipUrl = adhdPlannerBundle.payhip;
const cover = adhdPlannerBundle.pages[0];
const brainDump = findPage(adhdPlannerBundle, 'brain-dump')!;
const habitTracker = findPage(adhdPlannerBundle, 'habit-tracker')!;
const monthly = findPage(adhdPlannerBundle, 'monthly-overview')!;
const path = '/minimalist-printable-planner/';
const canonicalURL = `${SITE}${path}`;

const jsonLd = [
  breadcrumbNode(canonicalURL, [{ name: 'Minimalist printable planner' }]),
  {
    '@type': 'WebPage',
    '@id': `${canonicalURL}#webpage`,
    url: canonicalURL,
    name: 'A minimalist printable planner stripped to what matters',
    about: { '@id': `${SITE}/shop/adhd-planner-bundle/#product` },
    isPartOf: { '@id': `${SITE}/#website` },
    inLanguage: 'en',
  },
];
---
<BaseLayout
  title="Minimalist Printable Planner, Undated PDF"
  description="A minimalist printable planner with no filler: 13 undated, low-ink pages for the few things worth tracking, with a brain dump and a streak-free habit tracker."
  path={path}
  ogImage="/og/minimalist-printable-planner.png"
  jsonLd={jsonLd}
>
  <Header current="shop" />
  <main id="main">
    <section class="phero" aria-labelledby="hero-title">
      <div class="wrap">
        <div class="phero__copy">
          <h1 id="hero-title">A minimalist printable planner stripped to what matters</h1>
          <p class="phero__promise">No decorative filler, no pages you will never use. Undated layouts for the few things that genuinely need tracking, a brain dump page, and a habit tracker with no streak to break.</p>
          <div class="phero__buy" id="buy">
            <div class="phero__pricerow"><span class="phero__price">$17.99</span><span class="phero__pricenote">one purchase, both paper sizes</span></div>
            <div class="phero__actions">
              <a class="btn btn--primary" href={gumroadUrl} rel="nofollow" onclick="window.pintrk && pintrk('track', 'checkout', {value: 17.99, currency: 'USD'})">Get it on Gumroad</a>
              <a class="btn btn--secondary" href={payhipUrl} rel="nofollow" onclick="window.pintrk && pintrk('track', 'checkout', {value: 17.99, currency: 'USD'})">Buy on Payhip</a>
            </div>
          </div>
        </div>
        <div class="desk"><div class="paper paper--cover"><Image src={cover.img} alt={cover.alt} loading="eager" width={420} /></div></div>
      </div>
    </section>

    <section class="chunk chunk--mint" aria-labelledby="what-title">
      <div class="wrap">
        <div class="chunk__head">
          <h2 id="what-title">What counts as minimalist here</h2>
          <p class="measure">Undated pages, no decorative sections, a cream page with one tint of colour per block, and generous white space. The minimalism is also the ADHD design: fewer things on the page means fewer decisions before you start.</p>
        </div>
        <div class="products">
          <article class="product">
            <div class="paper"><Image src={brainDump.img} alt={brainDump.alt} loading="lazy" width={320} /></div>
            <div class="product__body"><h3>Brain Dump</h3><p>{brainDump.caption}</p></div>
          </article>
          <article class="product">
            <div class="paper"><Image src={habitTracker.img} alt={habitTracker.alt} loading="lazy" width={320} /></div>
            <div class="product__body"><h3>Habit Tracker</h3><p>{habitTracker.caption}</p></div>
          </article>
          <article class="product">
            <div class="paper"><Image src={monthly.img} alt={monthly.alt} loading="lazy" width={320} /></div>
            <div class="product__body"><h3>Monthly Overview</h3><p>{monthly.caption}</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="chunk" aria-labelledby="source-title">
      <div class="wrap">
        <h2 id="source-title" class="sr-only">Where this page lives</h2>
        <p class="measure">This is the full <a href="/shop/adhd-planner-bundle/">ADHD Planner Bundle</a>, thirteen pages in total, shown from the angle that matters most if minimalist is the bar: undated, no streaks, no filler. See the <a href="/shop/adhd-planner-bundle/">full page index</a> or try the <a href="/productivity-aesthetic-daily-planning/">calmer, more visual framing</a> instead.</p>
      </div>
    </section>

    <section class="chunk chunk--tint buy" aria-labelledby="buy-title">
      <div class="wrap buy__box">
        <h2 id="buy-title">ADHD Planner Bundle</h2>
        <div class="phero__pricerow"><span class="phero__price">$17.99</span><span class="phero__pricenote">13 pages, undated, US Letter and A4</span></div>
        <div class="phero__actions">
          <a class="btn btn--primary" href={gumroadUrl} rel="nofollow">Get it on Gumroad</a>
          <a class="btn btn--secondary" href={payhipUrl} rel="nofollow">Buy on Payhip</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
